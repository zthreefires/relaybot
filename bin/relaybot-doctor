#!/usr/bin/env bash
# relaybot-doctor [--webhook-test <bot>]
# Read-only self-check of a relaybot install. Prints what it finds; never prints webhook keys.
# --webhook-test <bot>  also POSTs a `test` event to <bot>'s webhook (expect "sent 200").
# shellcheck disable=SC2015
set -u
here=$(cd "$(dirname "$0")" && pwd)
RELAYBOT_HOME=${RELAYBOT_HOME:-$HOME/.config/relaybot}
ok=0; warn=0; bad=0
pass() { echo "ok    $*"; ok=$((ok+1)); }
note() { echo "warn  $*"; warn=$((warn+1)); }
fail() { echo "FAIL  $*"; bad=$((bad+1)); }

PY=${RELAYBOT_PYTHON:-$(command -v python3 || true)}
if [ -n "$PY" ] && [ -x "$PY" ]; then pass "python3: $PY"; else fail "python3 not found (set RELAYBOT_PYTHON)"; fi

for s in claude-run claude-stream-run codex-run codex-app-run codex-notify codex-relay-hook; do
  if [ -x "$here/$s" ]; then pass "script: $here/$s"; else fail "missing or not executable: $here/$s"; fi
done
bash -n "$here/codex-run" 2>/dev/null && pass "codex-run parses" || fail "codex-run has a syntax error"
for s in claude-stream-run codex-app-run codex-notify codex-relay-hook; do
  "$PY" -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$here/$s" 2>/dev/null && pass "$s parses" || fail "$s has a syntax error"
done

if [ -f "$RELAYBOT_HOME/config.env" ]; then pass "config: $RELAYBOT_HOME/config.env"; else note "no $RELAYBOT_HOME/config.env (defaults apply; see config.example.env)"; fi

# Keep account details in the probe process. Unsupported status commands and
# timeouts leave login unverified, so the other CLI can still be checked.
check_login() {
  local cli=$1 runner=$2 login_command=$3
  "$PY" - "$cli" "$runner" <<'P'
import json, subprocess, sys

cli, runner = sys.argv[1:]
try:
    result = subprocess.run([runner, "--login-status"], stdin=subprocess.DEVNULL, capture_output=True, timeout=10)
    if cli == "Codex":
        lines = result.stderr.splitlines() + result.stdout.splitlines()
        signed_in = any(line == b"Logged in" or line.startswith(b"Logged in ") for line in lines)
        if result.returncode == 0 and signed_in:
            sys.exit(0)
        if b"Not logged in" in lines:
            sys.exit(1)
    else:
        status = json.loads(result.stdout)
        if isinstance(status, dict):
            logged_in = status.get("loggedIn")
            method = status.get("authMethod")
            if "loggedIn" not in status and isinstance(method, str) and method.strip():
                logged_in = method.strip().lower() != "none"
            if logged_in is True and result.returncode == 0:
                sys.exit(0)
            if logged_in is False and result.returncode in (0, 1):
                sys.exit(1)
except (OSError, ValueError, subprocess.TimeoutExpired):
    pass
sys.exit(2)
P
  case $? in
    0) pass "$cli signed in" ;;
    1) note "$cli signed out (run $login_command in your terminal, then /relaybot-setup)" ;;
    *) note "$cli login unverified (check the installed CLI's auth status in your terminal)" ;;
  esac
}

claude_bin=$("$here/claude-run" --print-claude-bin 2>/dev/null)
if [ -f "$claude_bin" ] && [ -x "$claude_bin" ]; then
  pass "claude: $claude_bin"
  check_login "Claude Code" "$here/claude-run" "claude auth login"
else
  note "Claude Code unavailable (install Claude Code or set RELAYBOT_CLAUDE_BIN to its executable)"
fi

codex_bin=$("$here/codex-run" --print-codex-bin 2>/dev/null)
if [ -f "$codex_bin" ] && [ -x "$codex_bin" ]; then
  pass "codex: $codex_bin ($("$codex_bin" --version 2>/dev/null | head -1))"
  check_login "Codex" "$here/codex-run" "codex login"
  "$codex_bin" app-server --help >/dev/null 2>&1 && pass "codex app-server available" \
    || note "codex app-server not available: runs will use the exec fallback (not visible in the desktop)"
else
  note "Codex unavailable (install the Codex CLI or set RELAYBOT_CODEX_BIN to its executable)"
  if [ ! -f "$claude_bin" ] || [ ! -x "$claude_bin" ]; then fail "no coding CLI found"; fi
fi

[ -S "$HOME/.codex/ipc/ipc.sock" ] && pass "desktop IPC socket present (live sidebar refresh)" \
  || note "no ~/.codex/ipc/ipc.sock: desktop not running; threads appear after it next loads"

wh="$RELAYBOT_HOME/webhooks"
if [ -d "$wh" ]; then
  perm=$(stat -c %a "$wh" 2>/dev/null || stat -f %Lp "$wh")
  [ "$perm" = 700 ] && pass "webhooks dir $wh (700)" || note "webhooks dir $wh is $perm, expected 700"
  for f in "$wh"/*.json; do
    [ -e "$f" ] || { note "no webhook configs yet (run /relaybot-setup in a bot)"; break; }
    "$PY" - "$f" <<'P' && pass "webhook $(basename "$f" .json): url/key/bot present" || fail "webhook $(basename "$f"): bad or incomplete json"
import json, sys
d = json.load(open(sys.argv[1]))
sys.exit(0 if all(d.get(k) for k in ("url", "key", "bot")) else 1)
P
  done
else
  note "no $wh yet (created by install.sh or /relaybot-setup)"
fi


if [ "${1:-}" = "--webhook-test" ] && [ -n "${2:-}" ]; then
  echo; echo "webhook test for $2:"
  if delivery=$("$here/codex-notify" "$2" test /tmp "$HOME" "relaybot-doctor connectivity test") && [[ $delivery == "sent "2[0-9][0-9] ]]; then
    echo "$delivery"
  else
    fail "webhook test: ${delivery:-codex-notify failed}"
  fi
fi
echo; echo "summary: $ok ok, $warn warn, $bad fail"
[ $bad -eq 0 ]
