#!/usr/bin/env bash
# Shared launcher for codex-run and claude-run. The invoked name selects the agent.
# Usage: <agent>-run <bot> <workdir|-> <task_file> [resume | --worktree <branch> (Codex)]
#        <agent>-run /resend <run_dir> [turn-id] [--force]   redeliver a recorded event, never rerun
# The snapshot, lock, pause, reply and webhook all belong to one launch.
set -u

agent=codex
if [ "${0##*/}" = claude-run ]; then agent=claude; fi
runner="$agent-run"
print_flag="--print-$agent-bin"

RELAYBOT_HOME=${RELAYBOT_HOME:-$HOME/.config/relaybot}
if [ -f "$RELAYBOT_HOME/config.env" ]; then
  # Values already in the environment win over the file.
  while IFS='=' read -r k v || [ -n "$k" ]; do
    case $k in ''|\#*) continue ;; esac
    k=$(printf '%s' "$k" | tr -d '[:space:]')
    # The handoff worker reads this switch from config.env again at delivery.
    # Leave it in the environment only when the caller supplied an override.
    [ "$k" = RELAYBOT_HANDOFF_AUTO_SYNC ] && continue
    case $k in RELAYBOT_*) ;; *) continue ;; esac
    v=${v%$'\r'}
    v=${v%\"}; v=${v#\"}
    if [ -z "${!k:-}" ]; then export "$k=${v/#\~/$HOME}"; fi
  done < "$RELAYBOT_HOME/config.env"
fi
export RELAYBOT_HOME

here=$(cd "$(dirname "$0")" && pwd)
[ -n "${RELAYBOT_EXTRA_PATH:-}" ] && PATH="$RELAYBOT_EXTRA_PATH:$PATH"
PATH="$here:$PATH"; export PATH

if [ "$agent" = claude ]; then
  binary=${RELAYBOT_CLAUDE_BIN:-$(command -v claude || echo "$HOME/.local/bin/claude")}
else
  desktop_codex=/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex
  if [ -z "${RELAYBOT_CODEX_BIN:-}" ]; then
    if [ -x "$desktop_codex" ]; then RELAYBOT_CODEX_BIN=$desktop_codex; else RELAYBOT_CODEX_BIN=$(command -v codex || echo codex); fi
  fi
  export RELAYBOT_CODEX_BIN
  binary=$RELAYBOT_CODEX_BIN
fi
if [ "${1:-}" = "$print_flag" ]; then
  command -v -- "$binary" || printf '%s\n' "$binary"
  exit 0
fi
# The doctor probes with the runner's PATH (some CLI launchers need Node there).
if [ $# -eq 1 ] && [ "$1" = "--login-status" ]; then
  if [ "$agent" = claude ]; then exec "$binary" auth status --json; fi
  exec "$binary" login status
fi
PY=${RELAYBOT_PYTHON:-$(command -v python3 || echo /usr/bin/python3)}
RUN_ROOT=${RELAYBOT_RUN_ROOT:-/tmp}
if [ "${1:-}" = /handoff ]; then
  [ $# -eq 3 ] || { echo "usage: $runner /handoff <run_dir> <workdir|->" >&2; exit 2; }
  workdir=$3
  if [ -z "$workdir" ] || [ "$workdir" = - ]; then workdir=${RELAYBOT_DEFAULT_WORKDIR:-$HOME/Documents/relaybot}; fi
  exec "$PY" "$here/desktop_handoff.py" "$agent" "$binary" "$RUN_ROOT" "$2" "$workdir"
fi
case "${1:-}" in
  /resend)
    [ "$#" -ge 2 ] && [ "$#" -le 4 ] || { echo "usage: $runner /resend <run_dir> [turn-id] [--force]" >&2; exit 2; }
    exec "$PY" "$here/codex-notify" --resend "${@:2}" ;;
  /auto-sync)
    if [ "$#" -lt 3 ]; then
      echo "usage: $runner /auto-sync <run_dir> <workdir|-> [on|off] [--bot <original-slug>]" >&2; exit 2
    fi
    exec "$PY" "$here/handoff_sync.py" "$agent" "$RUN_ROOT" "$2" /auto-sync "${@:4}" ;;
  /sync)
    [ "$#" -ge 2 ] || { echo "usage: $runner /sync <run_dir> [--bot <original-slug>]" >&2; exit 2; }
    exec "$PY" "$here/handoff_sync.py" "$agent" "$RUN_ROOT" "$2" /sync "${@:3}" ;;
esac
mode=${4:-}
choice=""
usage() {
  echo "usage: $runner <bot> <workdir|-> <task_file> [resume]" >&2
  if [ "$agent" = codex ]; then echo "       codex-run <bot> <main-repo> <task_file> --worktree <branch>" >&2; fi
  if [ "$agent" = claude ]; then echo "       claude-run <bot> <workdir> <file-in-run-dir> --permission-choice <turn> ask|yes|no" >&2; fi
  exit 2
}
case "$#:$mode" in
  3:|4:|4:resume) ;;
  5:--worktree) [ "$agent" = codex ] && [ -n "$2" ] && [ "$2" != - ] && [ -n "$5" ] || usage ;;
  6:--permission-choice)
    [ "$agent" = claude ] || usage
    case "$6" in ask|yes|no) choice=$6 ;; *) usage ;; esac
    question_turn=$5
    mode=resume ;;
  *) usage ;;
esac
bot=$1; workdir=$2; task=$3
shift 3

# "-" (or empty) means the default workdir for tasks tied to no existing project.
if [ -z "$workdir" ] || [ "$workdir" = - ]; then workdir=${RELAYBOT_DEFAULT_WORKDIR:-$HOME/Documents/relaybot}; fi
die() { echo "$runner: $*" >&2; exit 1; }
[ -f "$task" ] && [ -r "$task" ] || die "cannot read task file: $task"

sid=""
if [ "$mode" = resume ]; then
  run=$(cd "$(dirname "$task")" && pwd) || die "cannot open run directory"
  [[ ${run##*/} = "$runner"-?* && -O $run && ! -L $run && -f $run/task.md && -f $run/prompt.md && -f $run/pause ]] ||
    die "not an owned relaybot run directory: $run"
fi
managed=
if [ "$mode" = --worktree ] || { [ "$agent" = codex ] && [ "$mode" = resume ] && [ -f "$run/worktree" ]; }; then
  managed=1
else
  if [ -z "$choice" ]; then mkdir -p "$workdir" || die "cannot open workdir: $workdir"; fi
fi
if [ "$mode" != resume ]; then
  mkdir -p "$RUN_ROOT" || die "cannot create run root"
  run=$(mktemp -d "$RUN_ROOT/$runner-XXXXXXXX") || die "cannot create private run directory"
  run=$(cd "$run" && pwd) || die "cannot open run directory"
fi
# Webhook delivery can precede the original runner releasing its lock. Claiming a
# chat question only reads this run; the helper serializes claims per installation.
if [ "$choice" = ask ]; then
  sid=$(cat "$run/session") || die "cannot read session ID"
  exec "$PY" "$here/claude_preference.py" "$bot" "$run" "$question_turn" "$workdir" "$sid" ask
fi
# flock the open directory description inherited from bash. The kernel releases
# the lock on exit, including after a crash. No platform-specific flock CLI.
exec 9< "$run" || die "cannot open run directory"
"$PY" -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)' 2>/dev/null ||
  die "run already in progress or cannot lock: $run"
if [ "$mode" = resume ]; then
  sid=$(cat "$run/session") || die "cannot read session ID: $run/session"
  [[ -n $sid && $sid != -* && $sid != *[[:space:]]* ]] || die "invalid session ID in $run/session"
  if [ "$agent" = claude ]; then
    uuid='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
    [[ $sid =~ $uuid ]] || die "invalid Claude session UUID in $run/session"
  fi
  export RELAYBOT_RESUME_ID=$sid
fi
if [ -n "$choice" ]; then
  "$PY" "$here/claude_preference.py" "$bot" "$run" "$question_turn" "$workdir" "$sid" "$choice" || exit 1
  if [ "$choice" = no ]; then echo "Claude will use local permissions. The task is paused."; exit 0; fi
  export RELAYBOT_CLAUDE_SKIP_PERMISSIONS=1
fi
turn=$(mktemp -d "$run/turn-XXXXXXXX") || die "cannot create private turn directory"
if ! cat "$task" > "$turn/input.md"; then
  rm -f "$turn/input.md"
  rmdir "$turn"
  if [ "$mode" != resume ]; then rmdir "$run"; fi
  die "cannot snapshot task: $task"
fi
# A stable 1-based turn number for this run, counted under the run lock.
seq=0
for d in "$run"/turn-*/; do [ -d "$d" ] && seq=$((seq + 1)); done
echo "$seq" > "$turn/seq" || die "cannot number turn"
if [ "$mode" = resume ]; then
  chmod 700 "$run" || die "cannot secure run directory"
  if [ -e "$run/last.md" ]; then
    mv "$run/last.md" "$turn/previous-last.md" || die "cannot archive previous reply"
  fi
else
  cp "$turn/input.md" "$run/task.md" || die "cannot save task"
fi
# Older runs acquire a route on their first dispatch after upgrade.
if [ ! -f "$run/origin.json" ]; then
  "$PY" "$here/relaybot_files.py" "$run" "$bot" || die "cannot save originating webhook route"
fi
# A resume keeps its original bot, workdir and session; a mismatch fails as resume_mismatch.
bind_mode=; [ "$mode" = resume ] && bind_mode=resume
mismatch=$("$PY" "$here/relaybot_files.py" --bind "$run" "$turn" "$bot" "$workdir" $bind_mode)
bound=$?
case $bound in 0|3) ;; *) die "cannot check the run binding" ;; esac
export RELAYBOT_RUN_DIR=$run RELAYBOT_TURN_DIR=$turn
# The prompt is the task, verbatim. Nothing is appended (it would show in the desktop thread).
cat "$turn/input.md" > "$run/prompt.md" || die "cannot prepare prompt"
echo $$ > "$run/pid" || die "cannot save pid"
echo "${turn##*/}" > "$turn/pause" || die "cannot save pause"
mv "$turn/pause" "$run/pause" || die "cannot switch turn"
rm -f "$run/status.json" "$run/exit" || die "cannot clear previous result"

: >> "$run/log.txt" || die "cannot open run log"
log_start=$(wc -c < "$run/log.txt") || die "cannot read log size"
echo "started run_dir=$run"
# A stop request (TERM, INT, HUP) reaches the backend as TERM so it can end the turn and keep
# its partial reply; the launcher still resolves the status and sends the turn's event.
child=; stopped=
# shellcheck disable=SC2329  # invoked by the traps below
forward() {
  stopped=$1
  if [ -n "$child" ]; then kill -TERM "$child" 2>/dev/null; fi
}
trap 'forward TERM' TERM; trap 'forward INT' INT; trap 'forward HUP' HUP
backend() {  # backend <stdin> <command...>: wait for the command through forwarded signals
  local input=$1; shift
  "$@" < "$input" &
  child=$!
  wait "$child"; rc=$?
  while [ -n "$stopped" ] && kill -0 "$child" 2>/dev/null; do wait "$child"; rc=$?; done
  child=
}
# shellcheck disable=SC2329  # invoked through backend()
exec_new() { exec "$binary" exec -C "$workdir" "${opts[@]}"; }
# shellcheck disable=SC2329  # invoked through backend()
exec_resume() { cd "$workdir" && exec "$binary" exec resume "$sid" "${opts[@]}"; }
rc=97
if [ "$bound" = 3 ]; then
  echo "[$runner] $mismatch" >> "$run/log.txt"
  rc=1
elif [ "$agent" = claude ]; then
  backend /dev/null "$PY" "$here/claude-stream-run" "$binary" "$workdir" "$sid" >> "$run/log.txt" 2>&1
elif [ -x "$here/codex-app-run" ] && [ -z "${RELAYBOT_FORCE_EXEC:-}" ]; then
  backend /dev/null "$here/codex-app-run" "$bot" "$workdir" "$run" "$@" >> "$run/log.txt" 2>&1
fi
if [ -n "$stopped" ] && [ $rc -eq 97 ]; then
  rc=$((128 + 15))
elif [ "$managed" ] && [ $rc -eq 97 ]; then
  echo "[codex-run] managed worktree runs require the Codex app-server" >> "$run/log.txt"
  rc=1
elif [ "$agent" = codex ] && [ $rc -eq 97 ]; then
  echo "[codex-run] app-server path unavailable, falling back to codex exec" >> "$run/log.txt"
  model_args=(); [ -n "${RELAYBOT_MODEL:-}" ] && model_args=(-m "$RELAYBOT_MODEL")
  effort_args=(); [ -n "${RELAYBOT_EFFORT:-}" ] && effort_args=(-c "model_reasoning_effort=\"$RELAYBOT_EFFORT\"")
  opts=(${model_args[@]+"${model_args[@]}"} ${effort_args[@]+"${effort_args[@]}"} --skip-git-repo-check -o "$turn/reply.md" -)
  if [ -n "${RELAYBOT_SANDBOX:-}" ]; then opts=(-c "sandbox_mode=$RELAYBOT_SANDBOX" "${opts[@]}"); fi
  # Keep the live log and scope the session header to this invocation.
  offset=$(wc -c < "$run/log.txt") || die "cannot read log size"
  if [ "$mode" = resume ]; then
    backend "$run/prompt.md" exec_resume >> "$run/log.txt" 2>&1
  else
    backend "$run/prompt.md" exec_new >> "$run/log.txt" 2>&1
  fi
  header=$(tail -c "+$((offset+1))" "$run/log.txt" | awk '/^session id: / {print $3; exit}')
  if [ "$mode" != resume ] && [ -n "$header" ]; then
    echo "$header" > "$run/session" || die "cannot save session ID"
  elif [ "$mode" = resume ] && [ -n "$header" ] && [ "$header" != "$sid" ]; then
    echo "[codex-run] resumed a different session from the requested ID" >> "$run/log.txt"
    PYTHONPATH=$here "$PY" -c 'import sys; from relaybot_files import note_turn; note_turn(sys.argv[1], "failed", "resume_mismatch", sys.argv[2])' \
      "$turn" "Codex resumed session $header instead of $sid." 2>> "$run/log.txt"
    [ "$rc" != 0 ] || rc=1
  fi
fi
# turn-*/last.md is this turn's reply and is never rewritten; last.md mirrors the latest one.
# A stopped or failed turn keeps the text it had in turn-*/partial.md.
if [ -s "$turn/reply.md" ]; then
  mv "$turn/reply.md" "$turn/last.md" || die "cannot save reply"
  chmod 444 "$turn/last.md" || die "cannot save reply"
  cat "$turn/last.md" > "$turn/publish.tmp" || die "cannot publish reply"
  mv "$turn/publish.tmp" "$run/last.md" || die "cannot publish reply"
fi
if [ -s "$turn/partial.md" ]; then chmod 444 "$turn/partial.md" || die "cannot save partial reply"; fi
if [ -f "$run/session" ]; then
  sid=$(cat "$run/session")
  "$PY" "$here/relaybot_files.py" --bind-session "$run" || die "cannot record the run's session"
fi
result=$(RELAYBOT_STOP_SIGNAL=$stopped "$PY" "$here/codex-relay-hook" --result "$rc" "$log_start" "$bot" "$workdir") || die "cannot resolve turn status"
st=${result%%$'\n'*}
why=${result#*$'\n'}
if [ "$st" = failed ] && [ "$rc" = 0 ]; then rc=1; fi
echo "$rc" > "$run/exit" || die "cannot save exit code"
if [ "$managed" ] && [ -s "$run/worktree" ]; then workdir=$(cat "$run/worktree"); fi
"$here/codex-notify" --final "$bot" "$st" "$run" "$workdir" "$why"
echo "run_dir=$run exit=$rc session=$sid status=$st"
exit "$rc"
