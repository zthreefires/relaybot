# relaybot configuration. install.sh copies this to ~/.config/relaybot/config.env
# (or $RELAYBOT_HOME/config.env) if that file does not exist yet.
# Format: KEY=VALUE, one per line; `~` is expanded. Environment variables override this file.
# Leave a value empty (or the line commented out) to use the default shown.

# Codex binary. Default: the codex bundled with the ChatGPT/Codex desktop app on macOS
# (/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex), else `codex` on PATH.
# RELAYBOT_CODEX_BIN=

# Claude Code binary. Default: claude on PATH, then ~/.local/bin/claude.
# RELAYBOT_CLAUDE_BIN=

# Codex model and reasoning effort. Default: unset, i.e. whatever your Codex config uses.
# RELAYBOT_MODEL=gpt-6.2-astra
# RELAYBOT_EFFORT=xhigh

# Sandbox mode for app-server runs (approval policy is always "never": runs are unattended).
# RELAYBOT_SANDBOX=danger-full-access

# Where tasks that belong to no existing project run. Create a Codex desktop project with this
# folder as its root so those runs are filed under it.
# RELAYBOT_DEFAULT_WORKDIR=~/Documents/relaybot
# Desktop project root used when no project matches the workdir. Defaults to the configured default workdir, else an existing codex-for-grok or default project.
# RELAYBOT_PROJECT_FALLBACK_ROOT=~/Documents/relaybot

# Folder where your existing clones live as <root>/<repo>. The dispatching agent runs tasks about
# an existing repo inside its clone here instead of creating a new folder.
# RELAYBOT_REPOS_ROOT=~/Developer

# Where per-run directories are created (<root>/<agent>-run-XXXXXXXX, mode 0700).
# RELAYBOT_RUN_ROOT=/tmp

# Extra PATH entries for both runners (e.g. a node version manager's bin dir).
# RELAYBOT_EXTRA_PATH=

# python3 used for the helper scripts.
# RELAYBOT_PYTHON=/usr/bin/python3

# Name the app-server and IPC client report to Codex.
# RELAYBOT_CLIENT_NAME=relaybot

# Optional hard cap per turn, in seconds. Default: none.
# RELAYBOT_MAX_SECONDS=
